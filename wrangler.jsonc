{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9ffcceea-5f5a-4272-859a-8007c0631589","database_name": "web-app2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6cd4425aebbf48da9209595562a1475d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
